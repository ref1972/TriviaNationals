limit_req_zone $binary_remote_addr zone=trivia_mail_relay:10m rate=5r/s;

server {
    listen 80;
    listen [::]:80;
    server_name mail.triviaworkshop.com;

    client_max_body_size 300k;

    location = /health {
        proxy_pass http://127.0.0.1:8082/health;
        proxy_set_header Host $host;
    }

    location = /v1/mail {
        limit_req zone=trivia_mail_relay burst=10 nodelay;
        proxy_pass http://127.0.0.1:8082/v1/mail;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 40s;
    }

    location / {
        return 404;
    }
}
